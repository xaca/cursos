---
interface Props {
  currentPage: number;
  totalPages: number;
  baseUrl: string;
}
const { currentPage, totalPages, baseUrl } = Astro.props;
---
{totalPages > 1 && (
  <nav class="mt-12 pt-8 border-t border-slate-200 dark:border-slate-800" aria-label="Paginación del blog">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div class="text-sm text-slate-600 dark:text-slate-400">
        Página {currentPage} de {totalPages}
      </div>
      <div class="flex gap-2">
        {currentPage > 1 && (
          <a
            href={currentPage === 2 ? baseUrl : `${baseUrl}/page/${currentPage - 1}`}
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 hover:border-blue-400/50 dark:hover:border-blue-500/50 transition-colors"
          >
            <span aria-hidden="true">←</span>
            Anterior
          </a>
        )}
        {currentPage < totalPages && (
          <a
            href={`${baseUrl}/page/${currentPage + 1}`}
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 hover:border-blue-400/50 dark:hover:border-blue-500/50 transition-colors"
          >
            Siguiente
            <span aria-hidden="true">→</span>
          </a>
        )}
      </div>
    </div>
  </nav>
)}
