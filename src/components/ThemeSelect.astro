---
// Custom theme selector - single SVG icon to avoid corruption, no label-icon so StarlightThemeProvider won't touch it
const iconPaths: Record<string, string> = {
  dark: 'M21.64 13a1 1 0 0 0-1.05-.14 8.049 8.049 0 0 1-3.37.73 8.15 8.15 0 0 1-8.14-8.1 8.59 8.59 0 0 1 .25-2A1 1 0 0 0 8 2.36a10.14 10.14 0 1 0 14 11.69 1 1 0 0 0-.36-1.05Zm-9.5 6.69A8.14 8.14 0 0 1 7.08 5.22v.27a10.15 10.15 0 0 0 10.14 10.14 9.784 9.784 0 0 0 2.1-.22 8.11 8.11 0 0 1-7.18 4.32v-.04Z',
  light: 'M5 12a1 1 0 0 0-1-1H3a1 1 0 0 0 0 2h1a1 1 0 0 0 1-1Zm.64 5-.71.71a1 1 0 0 0 0 1.41 1 1 0 0 0 1.41 0l.71-.71A1 1 0 0 0 5.64 17ZM12 5a1 1 0 0 0 1-1V3a1 1 0 0 0-2 0v1a1 1 0 0 0 1 1Zm5.66 2.34a1 1 0 0 0 .7-.29l.71-.71a1 1 0 1 0-1.41-1.41l-.66.71a1 1 0 0 0 0 1.41 1 1 0 0 0 .66.29Zm-12-.29a1 1 0 0 0 1.41 0 1 1 0 0 0 0-1.41l-.71-.71a1.004 1.004 0 1 0-1.43 1.41l.73.71ZM21 11h-1a1 1 0 0 0 0 2h1a1 1 0 0 0 0-2Zm-2.64 6A1 1 0 0 0 17 18.36l.71.71a1 1 0 0 0 1.41 0 1 1 0 0 0 0-1.41l-.76-.66ZM12 6.5a5.5 5.5 0 1 0 5.5 5.5A5.51 5.51 0 0 0 12 6.5Zm0 9a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7Zm0 3.5a1 1 0 0 0-1 1v1a1 1 0 0 0 2 0v-1a1 1 0 0 0-1-1Z',
  auto: 'M21 14h-1V7a3 3 0 0 0-3-3H7a3 3 0 0 0-3 3v7H3a1 1 0 0 0-1 1v2a3 3 0 0 0 3 3h14a3 3 0 0 0 3-3v-2a1 1 0 0 0-1-1ZM6 7a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v7H6V7Zm14 10a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-1h16v1Z',
};
---

<starlight-theme-select>
  <label class="theme-select-label">
    <span class="sr-only">{Astro.locals.t('themeSelect.accessibleLabel')}</span>
    <span class="theme-icon" aria-hidden="true">
      <svg class="theme-icon-svg" viewBox="0 0 24 24" fill="currentColor" width="16" height="16" aria-hidden="true">
        <path class="theme-icon-path" d={iconPaths.auto} />
      </svg>
    </span>
    <select autocomplete="off" aria-label={Astro.locals.t('themeSelect.accessibleLabel')}>
      <option value="dark">{Astro.locals.t('themeSelect.dark')}</option>
      <option value="light">{Astro.locals.t('themeSelect.light')}</option>
      <option value="auto">{Astro.locals.t('themeSelect.auto')}</option>
    </select>
    <svg class="caret" viewBox="0 0 24 24" fill="currentColor" width="16" height="16" aria-hidden="true">
      <path d="M17 9.17a1 1 0 0 0-1.41 0L12 12.71 8.46 9.17a1 1 0 1 0-1.41 1.42l4.24 4.24a1.002 1.002 0 0 0 1.42 0L17 10.59a1.002 1.002 0 0 0 0-1.42Z" />
    </svg>
  </label>
</starlight-theme-select>

<script is:inline>
  if (typeof StarlightThemeProvider !== 'undefined') StarlightThemeProvider.updatePickers();
</script>

<script>
  type Theme = 'auto' | 'dark' | 'light';

  const storageKey = 'starlight-theme';
  const parseTheme = (theme: unknown): Theme =>
    theme === 'auto' || theme === 'dark' || theme === 'light' ? theme : 'auto';
  const loadTheme = (): Theme =>
    parseTheme(typeof localStorage !== 'undefined' && localStorage.getItem(storageKey));

  function storeTheme(theme: Theme): void {
    if (typeof localStorage !== 'undefined') {
      localStorage.setItem(storageKey, theme === 'light' || theme === 'dark' ? theme : '');
    }
  }

  const getPreferredColorScheme = (): Theme =>
    matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';

  function onThemeChange(theme: Theme): void {
    if (typeof StarlightThemeProvider !== 'undefined') {
      StarlightThemeProvider.updatePickers(theme);
    }
    document.documentElement.dataset.theme = theme === 'auto' ? getPreferredColorScheme() : theme;
    storeTheme(theme);
    updateIcon(theme);
  }

  const iconPaths: Record<Theme, string> = {
    dark: 'M21.64 13a1 1 0 0 0-1.05-.14 8.049 8.049 0 0 1-3.37.73 8.15 8.15 0 0 1-8.14-8.1 8.59 8.59 0 0 1 .25-2A1 1 0 0 0 8 2.36a10.14 10.14 0 1 0 14 11.69 1 1 0 0 0-.36-1.05Zm-9.5 6.69A8.14 8.14 0 0 1 7.08 5.22v.27a10.15 10.15 0 0 0 10.14 10.14 9.784 9.784 0 0 0 2.1-.22 8.11 8.11 0 0 1-7.18 4.32v-.04Z',
    light: 'M5 12a1 1 0 0 0-1-1H3a1 1 0 0 0 0 2h1a1 1 0 0 0 1-1Zm.64 5-.71.71a1 1 0 0 0 0 1.41 1 1 0 0 0 1.41 0l.71-.71A1 1 0 0 0 5.64 17ZM12 5a1 1 0 0 0 1-1V3a1 1 0 0 0-2 0v1a1 1 0 0 0 1 1Zm5.66 2.34a1 1 0 0 0 .7-.29l.71-.71a1 1 0 1 0-1.41-1.41l-.66.71a1 1 0 0 0 0 1.41 1 1 0 0 0 .66.29Zm-12-.29a1 1 0 0 0 1.41 0 1 1 0 0 0 0-1.41l-.71-.71a1.004 1.004 0 1 0-1.43 1.41l.73.71ZM21 11h-1a1 1 0 0 0 0 2h1a1 1 0 0 0 0-2Zm-2.64 6A1 1 0 0 0 17 18.36l.71.71a1 1 0 0 0 1.41 0 1 1 0 0 0 0-1.41l-.76-.66ZM12 6.5a5.5 5.5 0 1 0 5.5 5.5A5.51 5.51 0 0 0 12 6.5Zm0 9a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7Zm0 3.5a1 1 0 0 0-1 1v1a1 1 0 0 0 2 0v-1a1 1 0 0 0-1-1Z',
    auto: 'M21 14h-1V7a3 3 0 0 0-3-3H7a3 3 0 0 0-3 3v7H3a1 1 0 0 0-1 1v2a3 3 0 0 0 3 3h14a3 3 0 0 0 3-3v-2a1 1 0 0 0-1-1ZM6 7a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v7H6V7Zm14 10a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-1h16v1Z',
  };

  function updateIcon(theme: Theme): void {
    document.querySelectorAll('starlight-theme-select').forEach((picker) => {
      const select = picker.querySelector('select');
      const path = picker.querySelector('.theme-icon-path');
      if (!select || !path || !(path instanceof SVGPathElement)) return;
      const value = (theme || select.value) as Theme;
      path.setAttribute('d', iconPaths[value] ?? iconPaths.auto);
    });
  }

  matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
    if (loadTheme() === 'auto') onThemeChange('auto');
  });

  class StarlightThemeSelect extends HTMLElement {
    constructor() {
      super();
      const theme = loadTheme();
      const select = this.querySelector('select');
      if (select) {
        select.value = theme;
        select.addEventListener('change', (e) => {
          if (e.currentTarget instanceof HTMLSelectElement) {
            onThemeChange(parseTheme(e.currentTarget.value));
          }
        });
      }
      onThemeChange(theme);
    }
  }
  if (!customElements.get('starlight-theme-select')) {
    customElements.define('starlight-theme-select', StarlightThemeSelect);
  }
</script>

<style>
  @layer starlight.core {
    starlight-theme-select .theme-select-label {
      --sl-label-icon-size: 0.875rem;
      --sl-caret-size: 1.25rem;
      --sl-inline-padding: 0.625rem;
      --sl-select-width: 9.5em;
      position: relative;
      display: flex;
      align-items: center;
      gap: 0.25rem;
      color: var(--sl-color-gray-1);
      cursor: pointer;
      overflow: visible;
      min-height: 2.5rem;
      padding: 0.25rem 0;
      border-radius: 0.375rem;
      transition: color 0.15s ease, background-color 0.15s ease;
    }

    starlight-theme-select .theme-select-label:hover {
      color: var(--sl-color-gray-2);
    }

    starlight-theme-select .theme-select-label:focus-within {
      outline: 2px solid var(--sl-color-accent);
      outline-offset: 2px;
      border-radius: 0.375rem;
    }

    starlight-theme-select .theme-icon {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      inset-inline-start: 0;
      width: var(--sl-label-icon-size);
      height: var(--sl-label-icon-size);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      pointer-events: none;
    }

    starlight-theme-select .theme-icon svg {
      width: 100%;
      height: 100%;
      transition: opacity 0.2s ease;
    }

    starlight-theme-select select {
      border: 0;
      padding-block: 0.5rem;
      padding-inline: calc(var(--sl-label-icon-size) + var(--sl-inline-padding) + 0.25rem)
        calc(var(--sl-caret-size) + var(--sl-inline-padding) + 0.25rem);
      margin-inline: calc(var(--sl-inline-padding) * -1);
      width: calc(var(--sl-select-width) + var(--sl-inline-padding) * 2);
      min-width: 0;
      background-color: transparent;
      color: inherit;
      cursor: pointer;
      appearance: none;
      font: inherit;
    }

    starlight-theme-select select:focus {
      outline: none;
    }

    starlight-theme-select .caret {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      inset-inline-end: 0;
      width: var(--sl-caret-size);
      height: var(--sl-caret-size);
      font-size: var(--sl-caret-size);
      pointer-events: none;
    }

    :global([data-theme='light']) starlight-theme-select .theme-select-label {
      color: var(--sl-color-gray-4);
    }
    :global([data-theme='light']) starlight-theme-select .theme-select-label:hover {
      color: var(--sl-color-gray-3);
    }
  }
</style>
