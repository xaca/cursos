---
import '../styles/blog.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
const pathname = Astro.url.pathname;
const isBlog = pathname === '/blog' || pathname.startsWith('/blog/');
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=DM+Serif+Display&display=swap" rel="stylesheet" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body class="blog-body min-h-screen bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100">
    <header class="sticky top-0 z-50 border-b border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-slate-900/95 backdrop-blur-sm shadow-sm">
      <nav class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex items-center justify-between">
        <a href="/" class="font-serif text-xl font-semibold text-slate-800 dark:text-slate-100 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
          holamundo.co
        </a>
        <div class="flex gap-6">
          <a href="/" class={`nav-link ${!isBlog ? 'nav-link-active' : ''}`}>Curso</a>
          <a href="/blog" class={`nav-link ${isBlog ? 'nav-link-active' : ''}`}>Blog</a>
        </div>
      </nav>
    </header>
    <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-12">
      <slot />
    </main>
    <footer class="border-t border-slate-200 dark:border-slate-800 mt-16 py-8 bg-slate-100/50 dark:bg-slate-900/50">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-slate-600 dark:text-slate-400">
        <span>© {new Date().getFullYear()} holamundo.co</span>
        <div class="flex gap-6">
          <a href="/" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Curso</a>
          <a href="/blog" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Blog</a>
          <a href="https://github.com/xaca/teoria_programacion" target="_blank" rel="noopener noreferrer" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">GitHub</a>
        </div>
      </div>
    </footer>
  </body>
</html>
